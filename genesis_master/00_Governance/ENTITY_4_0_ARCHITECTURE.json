{
  "schema": "entity-4.0-target-architecture-v1",
  "target_version": "4.0.0",
  "status": "ACTIVE_DEVELOPMENT_NOT_CERTIFIED",
  "mission": "Sovereign digital rights infrastructure for people and organizations without mandatory purchase of domains, hosting, subscriptions, tokens, or platform accounts.",
  "architectural_laws": [
    "ENTITY is the sovereign identity, authority, rights, provenance and economic substrate.",
    "BSIE knows authoritative world and relationship state.",
    "NIKI reasons over least-privilege projections.",
    "ADAM acts only through governed capabilities and evidence.",
    "Gateway and relay route but never own an Entity.",
    "Raw private data stays out of public/shared ledgers.",
    "Cryptographic signatures prove statements and provenance, not legal truth.",
    "Camera AR remains first-class; dashboard AR is an additional projection surface.",
    "No user must purchase a domain to possess an Entity identity.",
    "Entity never claims knowledge beyond its Evidence Boundary.",
    "Data-source access is default-deny and requires explicit enrollment.",
    "Discovery, content access, NIKI content exposure, and economic rights are independent permissions.",
    "Newly discovered data is private and non-licensable by default.",
    "Provenance does not imply ownership, licensing authority, or monetary value."
  ],
  "core_layers": [
    "sovereign_root_identity",
    "privacy_pairwise_identity_and_credentials",
    "encrypted_data_vault",
    "asset_and_provenance_graph",
    "rights_and_claims_graph",
    "policy_and_consent_engine",
    "contract_and_licensing_engine",
    "trusted_usage_control",
    "transparency_and_evidence",
    "economic_and_settlement",
    "niki_adam_governance",
    "external_platform_gateway"
  ],
  "network_and_runtime": {
    "logical_entities": "effectively_unbounded",
    "physical_nodes": "many_entities_per_host_supported",
    "peer_network": [
      "direct_ipv6",
      "nat_traversal",
      "lan_discovery",
      "encrypted_relay_fallback",
      "offline_mesh_future"
    ],
    "public_internet": "compatibility_bridge_not_identity_root",
    "entity_namespace": "cryptographic_root_plus_human_aliases",
    "self_hosting": [
