{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entity.invalid/protocol/v3/ENTITY_V3_PRIMITIVES.schema.json",
  "title": "ENTITY Protocol 3.0 Primitive Records",
  "oneOf": [
    {"$ref": "#/$defs/entity"},
    {"$ref": "#/$defs/authority"},
    {"$ref": "#/$defs/right"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/value"}
