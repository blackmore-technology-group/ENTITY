      "additionalProperties": true,
      "properties": {
        "actor_entity_id": {
          "type": "string"
        },
        "created_at_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "minLength": 1,
          "type": "string"
        },
        "dedupe_key": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "economic_event_is_evidence_not_market_value": {
          "const": true
        },
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "gross_amount_units": {
          "minimum": 0,
          "type": "integer"
        },
        "instrument_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "entity-v3-economic-event-v1"
        },
        "subject_ref": {
          "type": "string"
        },
        "treasury_id": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "event_id",
        "dedupe_key",
        "event_type",
        "treasury_id",
        "actor_entity_id",
